# SOARForge Production Environment
# Copy to .env.local for local development or Vercel Environment Variables for deployment.
# Never commit .env or .env.local.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soarforge?sslmode=require"
SOARFORGE_SESSION_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
SOARFORGE_ADMIN_PASSWORD="replace-with-a-strong-demo-admin-password"

# Optional centralized production rate limiting adapter.
# When present, SOARForge uses Upstash Redis REST instead of local in-memory fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public application name only. Do not put secrets behind NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME="SOARForge"

# Optional proxy for enterprise restricted networks.
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="localhost,127.0.0.1"

# Offline bundle verification foundation.
SOARFORGE_BUNDLE_MAX_MB="10"
SOARFORGE_BUNDLE_PUBLIC_KEY=""
SOARFORGE_BUNDLE_PUBLIC_KEY_PEM=""
SOARFORGE_REQUIRE_BUNDLE_SIGNATURE="false"

# Future managed SSO/OIDC placeholders. Keep empty until enterprise IdP is configured.
SOARFORGE_OIDC_ISSUER=""
SOARFORGE_OIDC_CLIENT_ID=""
SOARFORGE_OIDC_CLIENT_SECRET=""

# Support / commercial packaging.
SOARFORGE_SUPPORT_EMAIL="support@example.com"
SOARFORGE_LICENSE_KEY="demo"
